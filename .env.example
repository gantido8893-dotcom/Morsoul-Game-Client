# ===================================================================
# Morsoul Game Launcher Client - Environment Configuration
# ===================================================================

# --- Required ---
# Base64 string of 32 random bytes for local save SQLite HMAC verification.
# Must match the server's SAVE_HMAC_KEY.
SAVE_HMAC_KEY=

# --- Server Discovery ---
# Raw GitHub URL pointing to your server.json (e.g. on your public repo).
# The launcher will fetch this URL on startup to discover your backend / Cloudflare Tunnel URL.
# Example: https://raw.githubusercontent.com/<username>/<repo>/main/server.json
SERVER_CONFIG_URL=

# Fallback server URL used if SERVER_CONFIG_URL is unreachable and server.json is missing locally.
DEFAULT_SERVER_URL=http://127.0.0.1:8080

# Optional launcher handshake key matching the server's LAUNCHER_KEY.
LAUNCHER_KEY=

# --- Game & Updates ---
# Base64 raw Ed25519 public key to verify game update manifests.
UPDATE_PUBLIC_KEY=

# Path to the game executable (e.g. C:\Games\Morsoul\Morsoul.exe)
GAME_EXE_PATH=

# Game installation root directory
GAME_INSTALL_DIR=

# Client launcher version
APP_VERSION=0.1.0

# Optional content directory for clue and case validation
CONTENT_DIR=
